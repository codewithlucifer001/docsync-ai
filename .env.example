# ==========================================
# DocSync AI - Environment Variables
# ==========================================

# Database & Cache (PostgreSQL + Upstash Redis)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docsync?schema=public"
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# Authentication (Clerk / Auth.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
GITHUB_CLIENT_ID="gh_client_id_placeholder"
GITHUB_CLIENT_SECRET="gh_client_secret_placeholder"

# LLM Providers (OpenAI / Anthropic for LangGraph parser)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Internal Microservice Communications
PARSER_SERVICE_URL="http://127.0.0.1:8000"
PARSER_SERVICE_API_KEY="internal_dev_secret_key"

# Static Deployment Targets
VERCEL_TOKEN="vercel_token_placeholder"
AWS_ACCESS_KEY_ID="aws_access_key_placeholder"
AWS_SECRET_ACCESS_KEY="aws_secret_key_placeholder"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_DOCS="docsync-generated-docs"
